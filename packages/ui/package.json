{
  "name": "@pieai/university-ui",
  "version": "0.0.0",
  "private": true,
  "description": "The learning surface both shells render. Neither app is allowed a second copy of anything in here.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./Tip.js": "./src/Tip.tsx",
    "./api/client.js": "./src/api/client.ts",
    "./api/ua-dashboard.js": "./src/api/ua-dashboard.ts",
    "./entry/entry-page.css": "./src/entry/entry-page.css",
    "./evidence/EvidenceCode.js": "./src/evidence/EvidenceCode.tsx",
    "./evidence/EvidenceRail.js": "./src/evidence/EvidenceRail.tsx",
    "./favourites/favourites.css": "./src/favourites/favourites.css",
    "./language/ForeignSettingsPanel.js": "./src/language/ForeignSettingsPanel.tsx",
    "./language/foreign-settings.js": "./src/language/foreign-settings.ts",
    "./language/reading-mode.js": "./src/language/reading-mode.ts",
    "./language/word-layer.css": "./src/language/word-layer.css",
    "./lesson/LessonNav.js": "./src/lesson/LessonNav.tsx",
    "./lesson/LessonReader.js": "./src/lesson/LessonReader.tsx",
    "./markdown/MarkdownContent.js": "./src/markdown/MarkdownContent.tsx",
    "./markdown/remark-lesson-links.js": "./src/markdown/remark-lesson-links.ts",
    "./path/path-cards.css": "./src/path/path-cards.css",
    "./reference/reference-panel.css": "./src/reference/reference-panel.css",
    "./reference/term-index.css": "./src/reference/term-index.css",
    "./review/ReviewCard.js": "./src/review/ReviewCard.tsx",
    "./review/VocabularyReview.js": "./src/review/VocabularyReview.tsx",
    "./shell/AppShell.js": "./src/shell/AppShell.tsx",
    "./shell/CounterRow.js": "./src/shell/CounterRow.tsx",
    "./shell/NavRail.js": "./src/shell/NavRail.tsx",
    "./shell/TabBar.js": "./src/shell/TabBar.tsx",
    "./shell/app-shell.css": "./src/shell/app-shell.css",
    "./shell/icons.js": "./src/shell/icons.tsx",
    "./sound/index.js": "./src/sound/index.ts",
    "./sound/sound-toggle.css": "./src/sound/sound-toggle.css",
    "./view/lesson-view.js": "./src/view/lesson-view.ts"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint --deny-warnings src",
    "format": "oxfmt --write package.json tsconfig.json src",
    "format:check": "oxfmt --check package.json tsconfig.json src",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -b --pretty false"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@pieai/swimmer-ui-kit": "1.3.2",
    "@pieai/university-core": "workspace:*",
    "mermaid": "11.16.0",
    "react-markdown": "10.1.0",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.3.1",
    "uisfx": "0.4.0",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
