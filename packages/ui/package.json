{
  "name": "@pieai/university-ui",
  "version": "0.0.0",
  "private": true,
  "description": "The learning surface both shells render. Neither app is allowed a second copy of anything in here.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint --deny-warnings src",
    "format": "oxfmt --write package.json tsconfig.json src",
    "format:check": "oxfmt --check package.json tsconfig.json src",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -b --pretty false"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@pieai/swimmer-ui-kit": "1.3.2",
    "@pieai/university-core": "workspace:*",
    "mermaid": "11.16.0",
    "react-markdown": "10.1.0",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.3.1",
    "uisfx": "0.4.0",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
