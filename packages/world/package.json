{
  "name": "@pieai/university-world",
  "version": "0.0.0",
  "private": true,
  "description": "The 3D scene both shells will render. packages/ui stays at zero three.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./course-map.js": "./src/course/course-map.ts",
    "./Maps.js": "./src/Maps.tsx",
    "./Stage.js": "./src/Stage.tsx",
    "./WorldMapCanvas.js": "./src/WorldMapCanvas.tsx",
    "./avatar.js": "./src/avatar/index.ts",
    "./companion-probe.js": "./src/companion/companion-probe.tsx",
    "./controls.js": "./src/camera/controls.tsx",
    "./course.js": "./src/course/course.ts",
    "./frame.js": "./src/camera/frame.ts",
    "./labels.js": "./src/labels/labels.ts",
    "./overlay.css": "./src/overlay.css",
    "./path-overlay.js": "./src/labels/path-overlay.ts",
    "./planet.js": "./src/planet/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings src vitest.config.ts",
    "format": "oxfmt --write package.json tsconfig.json vitest.config.ts src",
    "format:check": "oxfmt --check package.json tsconfig.json vitest.config.ts src",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pieai/swimmer-avatar-kit": "0.2.0",
    "@pieai/swimmer-render-kit": "0.3.0",
    "@pieai/swimmer-ui-kit": "1.8.1",
    "@pieai/university-core": "workspace:*",
    "@pieai/university-ui": "workspace:*",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "9.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.185.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "9.6.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.185.1"
  }
}
