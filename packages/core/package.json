{
  "name": "@pieai/university-core",
  "version": "0.0.0",
  "private": true,
  "description": "The domain model both shells agree on. Types and schemas only — no React, no filesystem, no network.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./concepts/heads.js": "./dist/concepts/heads.js",
    "./domain/schemas.js": "./dist/domain/schemas.js",
    "./domain/lesson-marks.js": "./dist/domain/lesson-marks.js",
    "./domain/reader-marks.js": "./dist/domain/reader-marks.js",
    "./domain/merge-text-runs.js": "./dist/domain/merge-text-runs.js",
    "./marks/references.js": "./dist/marks/references.js",
    "./marks/terms.js": "./dist/marks/terms.js",
    "./marks/evidence.js": "./dist/marks/evidence.js",
    "./language/layer.js": "./dist/language/layer.js",
    "./language/resolve-anchors.js": "./dist/language/resolve-anchors.js"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings src",
    "format": "oxfmt --write package.json tsconfig.json src",
    "format:check": "oxfmt --check package.json tsconfig.json src",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ts-fsrs": "5.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
