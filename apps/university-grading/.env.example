# Server-only configuration. Never prefix these with VITE_ and never commit a
# real value. The Vercel project should set them in its environment instead.
SWIMMER_BACKEND_SUPABASE_URL=https://<your-project-ref>.supabase.co
SWIMMER_BACKEND_PUBLISHABLE_KEY=sb_publishable_<your-public-key-placeholder>
# Deprecated compatibility aliases; remove after the service environments are migrated.
SWIMMER_CORE_SUPABASE_URL=https://<your-project-ref>.supabase.co
SWIMMER_CORE_PUBLISHABLE_KEY=sb_publishable_<your-public-key-placeholder>
OPENROUTER_API_KEY=<server-only-openrouter-key-placeholder>
UNIVERSITY_WALLET_APP_ID=university
UNIVERSITY_WEB_ORIGIN=https://<your-university-site.example>
