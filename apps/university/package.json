{
  "name": "@pieai/university-app",
  "version": "0.0.0",
  "private": true,
  "description": "University — one browser app, two modes. `--mode authoring` writes courses on a machine; `--mode delivery` sells them.",
  "type": "module",
  "scripts": {
    "dev": "vite --mode delivery",
    "dev:local": "vite --mode authoring",
    "journey": "node scripts/pull-taxonomy.mjs",
    "kit": "node scripts/import-kit.mjs",
    "build": "tsc -b && vite build --mode delivery && vite build --mode authoring",
    "check:generated-format": "oxfmt --check src/content/imported.json src/content/lexicon.json",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint --deny-warnings src vite.config.ts vitest.config.ts",
    "format": "oxfmt --write package.json tsconfig.app.json vite.config.ts vitest.config.ts index.html src",
    "format:check": "oxfmt --check package.json tsconfig.app.json vite.config.ts vitest.config.ts index.html src",
    "test": "vitest run --passWithNoTests",
    "content": "pnpm --filter @pieai/university-core build && node scripts/import-courses.mjs"
  },
  "dependencies": {
    "@pieai/swimmer-avatar-kit": "0.2.0",
    "@pieai/swimmer-render-kit": "0.3.0",
    "@pieai/swimmer-ui-kit": "1.8.1",
    "@pieai/university-backend": "workspace:*",
    "@pieai/university-core": "workspace:*",
    "@pieai/university-ui": "workspace:*",
    "@pieai/university-world": "workspace:*",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "9.6.1",
    "@supabase/supabase-js": "2.110.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.185.1",
    "three-stdlib": "^2.36.1",
    "ts-fsrs": "5.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
