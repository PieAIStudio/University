# Build-time browser configuration. Replace placeholders in .env.local or the
# deployment environment; never commit the filled values.
# The browser may receive only a publishable key. Use the canonical
# SwimmerBackend names below in local and Vercel configuration.
VITE_SWIMMER_BACKEND_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SWIMMER_BACKEND_PUBLISHABLE_KEY=sb_publishable_<your-public-key-placeholder>
VITE_POSTHOG_KEY=phc_<your-posthog-key-placeholder>
VITE_POSTHOG_HOST=https://<your-posthog-host-placeholder>
VITE_ENABLE_POSTHOG=false
VITE_UNIVERSITY_GRADING_URL=https://<your-university-grading-service.example>/api/grade
# Public half of the Web Push VAPID key. Never put the private signing key here.
VITE_UNIVERSITY_VAPID_PUBLIC_KEY=<your-vapid-public-key>
