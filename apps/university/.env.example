# Build-time browser configuration. Replace placeholders in .env.local or the
# deployment environment; never commit the filled values.
# The browser may receive only a publishable key.
VITE_SWIMMER_CORE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SWIMMER_CORE_PUBLISHABLE_KEY=sb_publishable_<your-public-key-placeholder>
