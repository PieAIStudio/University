{
  "name": "@pieai/university-online",
  "version": "0.0.0",
  "private": true,
  "description": "University online — the commercial, gamified Web3D delivery shell.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "journey": "node scripts/pull-taxonomy.mjs",
    "kit": "node scripts/import-kit.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint --deny-warnings src vite.config.ts vitest.config.ts",
    "format": "oxfmt --write package.json tsconfig.app.json vite.config.ts vitest.config.ts index.html src",
    "format:check": "oxfmt --check package.json tsconfig.app.json vite.config.ts vitest.config.ts index.html src",
    "test": "vitest run --passWithNoTests",
    "content": "node scripts/import-courses.mjs"
  },
  "dependencies": {
    "@pieai/swimmer-avatar-kit": "0.1.0",
    "@pieai/swimmer-render-kit": "0.3.0",
    "@pieai/swimmer-ui-kit": "1.3.2",
    "@pieai/university-avatar": "workspace:*",
    "@pieai/university-core": "workspace:*",
    "@pieai/university-ui": "workspace:*",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "9.6.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.185.1",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.3",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
