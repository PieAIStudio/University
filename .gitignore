node_modules/
dist/
coverage/
*.log
*.tsbuildinfo
.DS_Store
.env
.env.*
!.env.example
.scratch/
.artifacts/
university.config.local.json

# PGS skill symlinks are intentionally visible in Git as part of the project
# setup contract. Their relative targets require the sibling
# ProjectGovernanceSystem checkout; .pro-gov/assets.lock.json records the exact
# assets and the control-plane plan can recreate them after checkout.
.pro-gov/agent-assets/

# Imported UniversityLocal course recovery packages are content, not source.
# University pulls them; it never edits them in place. The pull is reproducible
# from the manifest, so the bytes do not belong in this history.
/content/imported/

# Session handoff notes - working material, not project documentation.
.handoff/

# Pulled from UniversityLocal for a wireframe to render against a real lesson.
# It quotes private source verbatim, so it stays out of a page anyone can open.
docs/reference/player-journey/*/data/sample-lesson.json

# Imported course packages. They quote private repositories verbatim, so the
# bytes stay out of git; `content/manifest.json` is mirrored into
# `src/content/imported.json`, which IS tracked and makes the import
# reproducible.
#
# Anchored. Written when this app was the repository root, an unanchored
# `content/` matched at every depth — and quietly swallowed
# `apps/university/src/content/`, whose `library.ts` is hand-written source. A
# fresh clone could not build, and nobody would have found out until they
# cloned it.
/apps/university/content/

# The imported CC0 art kit is committed, not fetched.
#
# The import pipeline refuses anything that is not CC0 precisely so these bytes
# can be redistributed, and a repository that only builds on the one machine
# holding the donor cache is not a backup. Provenance stays in
# `src/world/kit.json`; `pnpm kit` re-derives the bytes rather than supplying
# them.

# Built output of the workspace packages. Regenerated by `pnpm build`.
packages/*/dist/

# Reference screen recordings. The teardown in
# docs/reference/借鉴的App/duolingo-teardown/ carries the extracted frames and
# the analysis; the source video is 88MB and belongs on disk, not in history.
docs/reference/借鉴的App/*.MP4
docs/reference/借鉴的App/*.mp4
docs/reference/借鉴的App/*.mov

# Subagent working notes and their screenshots. The findings that matter get
# written into docs or a commit message; the scratch pad does not.
SCRATCH/

# Trailing-slash patterns match directories only, so a *symlink* with the same
# name slips past them. A git worktree that symlinks these back to the main
# checkout — a normal way to run isolated agents — then commits the symlink,
# and merging it replaces the real directory with a link pointing at itself.
# That cost a content rebuild once. These extensionless twins catch the link.
apps/university/content
node_modules

# Agent scratch reports. Subagents are asked to write a REPORT.md in their own
# worktree; one of them staged it and it rode a merge into the repository root
# (66d3213). The report is for the person reading the branch, not for main.
#
# Browser-pass screenshots belong in the same bucket: evidence for the person
# reading the branch, not a binary that rides a merge onto main.
SHOTS/
REPORT.md
/REPORT.md
*-REPORT.md
BRIEF.md
BRIEF-RESULT*.md
SCRATCH/
.vercel

# Throwaway browser probes: screenshots and DOM measurements while chasing a
# visual bug. They belong to one debugging session, not to the repo.
/.shot.mjs
/.probe.mjs
/.probe2.mjs
/.pix.mjs
/.probe3.mjs
/.probe4.mjs

# Receipts and explainer output written by tooling outside the build.
artifacts/

# In-repository Codex worktrees. Parallel AI work must never appear as
# nested untracked source, and must never be deleted by another agent.
/.worktrees/

# AI-generated texture sources are production intermediates. The checked-in
# WebP outputs, processing metrics, and visual checks are the distributable
# evidence; source renders stay out of the runtime asset budget.
/tmp/island-textures-input/
.env*
