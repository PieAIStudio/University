{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "university-delivery",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@pieai/university-app",
        "dev"
      ],
      "port": 9998
    },
    {
      "name": "university-authoring",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@pieai/university-app",
        "dev:local"
      ],
      "port": 9999
    },
    {
      "name": "university-local-server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@pieai/university-local",
        "dev"
      ],
      "port": 4317
    },
    {
      "name": "cutout-studio",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "../CutoutStudio",
        "dev",
        "--port",
        "5199",
        "--strictPort"
      ],
      "port": 5199
    },
    {
      "name": "courses-local-server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-C",
        "../University-courses",
        "--filter",
        "@pieai/university-local",
        "dev"
      ],
      "port": 4317
    },
    {
      "name": "courses-authoring",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-C",
        "../University-courses",
        "--filter",
        "@pieai/university-app",
        "dev:local"
      ],
      "port": 9999
    },
    {
      "name": "swimmer-ui-showcase",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "../SwimmerUIKit",
        "dev"
      ],
      "port": 5174
    }
  ]
}
